# ── Email delivery (EmailJS) ─────────────────────────────────────────────
# Sample requests and sourcing briefs are emailed through EmailJS, which runs
# in the browser, so these must be NEXT_PUBLIC_*. They are not secrets: an
# EmailJS public key is designed to be visible in client code. Lock the
# account down with the domain allow-list in the EmailJS dashboard instead.
#
# Find these at dashboard.emailjs.com:
#   Service ID   → Email Services
#   Template ID  → Email Templates
#   Public key   → Account → General → API Keys
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ── Optional webhook ─────────────────────────────────────────────────────
# If set, submissions are ALSO forwarded as JSON to this URL (Zapier, Make,
# a CRM…). Server-side, so it only runs on a Node deploy, not a static export.
FORM_WEBHOOK_URL=
