# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.next.config.ts.bak
.api-submit.bak

# production
/build

# misc
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets stay local, but .env.example is documentation
# and must be committed so the webhook variable is discoverable.
.env*
!.env.example

# netlify
.netlify

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea
.vscode/*
!.vscode/extensions.json
